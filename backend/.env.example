APP_ENV=development
# ローカル開発（uvicorn直起動）時はWorkerのプロキシ経由でD1/R2にアクセスする。
# Worker（localhost:8787）が起動している必要がある。
D1_GATEWAY_URL=http://localhost:8787/d1
R2_GATEWAY_URL=http://localhost:8787/r2
REQUEST_TIMEOUT_SECONDS=10
# gesuido（旧・下水道局）または kensetsu（新・建設局）。変更後はAPIを再起動する。
HAZARD_DATA_PROFILE=kensetsu
# 必須。python -c "import secrets; print(secrets.token_hex(32))" で生成する
JWT_SECRET_KEY=
