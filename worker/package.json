{
  "name": "saigai-map-worker",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "assets:build": "npm --prefix ../frontend run build",
    "predev": "npm run assets:build",
    "dev": "wrangler dev",
    "predeploy": "npm run assets:build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply safe-evac-route-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply safe-evac-route-db --remote",
    "tiles:upload": "node scripts/upload-tiles.mjs",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "allowScripts": {
    "workerd@1.20260811.1": true,
    "esbuild@0.28.1": true
  }
}
