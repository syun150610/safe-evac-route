{
  "name": "saigai-map-worker",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "assets:build": "npm --prefix ../frontend run build",
    "predev": "npm run assets:build",
    "dev": "wrangler dev",
    "predeploy": "npm run assets:build",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply safe-evac-route-db --remote",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  }
}
