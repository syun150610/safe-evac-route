# Geodata. 実データは gitignore。raw は配布元から取り直せ、processed は
# backend/prep で再生成できる（backend/prep/paths.py に置き場の一覧）。
# ⚠️ processed を無視し忘れると、浸水タイル 2,491枚が commit 対象になる。
#
# data/ 配下は実ディレクトリを使い、symlink は使わない。末尾スラッシュ付きの規則に
# 限定することで、誤って置いた symlink を git status に表示して見逃さない。
data/raw/
# 実データはignoreし、標準ディレクトリを示すplaceholderだけ追跡する。
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/raw/hazard/
data/raw/hazard/*
!data/raw/hazard/.gitkeep
!data/raw/tokyoto_kensetsukyoku/
data/raw/tokyoto_kensetsukyoku/*
!data/raw/tokyoto_kensetsukyoku/.gitkeep
!data/raw/tokyoto_toshiseibikyoku/
data/raw/tokyoto_toshiseibikyoku/*
!data/raw/tokyoto_toshiseibikyoku/.gitkeep
data/processed/
# processedも実成果物はignoreし、空ディレクトリを保つplaceholderだけ追跡する。
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/processed/bundles/
data/processed/bundles/*
!data/processed/bundles/.gitkeep
!data/processed/graph/
data/processed/graph/*
!data/processed/graph/.gitkeep
!data/processed/runtime_graph/
data/processed/runtime_graph/*
!data/processed/runtime_graph/.gitkeep
!data/processed/tiles/
data/processed/tiles/*
!data/processed/tiles/.gitkeep
data/cache/
# OSMnxの再生成可能なcache本体はignoreし、標準配置だけを示す。
!data/cache/
data/cache/*
!data/cache/.gitkeep

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Editors and operating systems
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
